[Unit]
Description=Project Phoenix Backend (FastAPI + Uvicorn)
After=network.target postgresql.service redis.service
Wants=network.target

[Service]
Type=simple
User=phoenix
Group=phoenix
WorkingDirectory=/opt/phoenix/backend
Environment="PATH=/opt/phoenix/backend/venv/bin"
EnvironmentFile=/opt/phoenix/backend/.env
ExecStart=/opt/phoenix/backend/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --log-level info \
    --log-config /opt/phoenix/backend/deploy/logging.json
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/phoenix/backend/storage /opt/phoenix/backend/phoenix.db
ReadOnlyPaths=/opt/phoenix/backend/app /opt/phoenix/backend/venv

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=phoenix-backend

[Install]
WantedBy=multi-user.target
