# 环境变量配置文件（复制为 .env 后按需修改）

# ===== 应用配置 =====
APP_NAME=Project Phoenix - AI短视频操作系统
APP_VERSION=1.0.0
DEBUG=true

# ===== 数据库配置 =====
# 【重要】生产环境请勿使用 SQLite！高并发下会频繁出现 database is locked 错误
# 本地开发默认使用 SQLite，开箱即用
DATABASE_URL=sqlite:///./phoenix.db
#
# ===== 生产环境请使用 MySQL =====
# 请先手动创建数据库，然后注释掉上面的 SQLite 配置，启用下面这行
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/phoenix?charset=utf8mb4
# ===================================

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== 安全配置 =====
# 生产必须替换为随机长字符串，不要提交真实值到仓库
SECRET_KEY=change-me-in-production
# CORS 允许的来源，多个用逗号分隔，生产环境请勿用 *
# 示例：CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=*
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 存储配置 =====
STORAGE_PATH=./storage

# ===== AI 配置 =====
# 文案走火山方舟云端 (不占本机显存, 视频仍走本地 ComfyUI)
AI_PROVIDER=ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_API_KEY=<your-ark-api-key>
ARK_MODEL=deepseek-v4-flash
ARK_TIMEOUT=120
# 全本地备选: 把 AI_PROVIDER 改为 ollama, 并配置已安装的本机模型
# OLLAMA_MODEL=qwen3.8:27b-q4_K_M
# OLLAMA_URL=http://127.0.0.1:11434

# ===== 演示素材配置 =====
# 新用户注册时是否自动注入系统演示素材
DEMO_FOOTAGE_ENABLED=true
# 演示素材源目录（相对于 STORAGE_PATH）
DEMO_FOOTAGE_SOURCE_DIR=demo_footage
# 每个用户注入的演示素材最大数量
DEMO_FOOTAGE_MAX_COUNT=6
# 演示素材是否允许用户编辑标签
DEMO_FOOTAGE_ALLOW_EDIT_TAGS=false

# ===== H3 图生视频派发（生产）=====
# Phoenix 在服务器(无GPU)，ComfyUI/CosyVoice 在本地 GPU 机，经反向SSH隧道暴露 worker。
# 服务器填隧道内 worker 地址（与 LIPSYNC_REMOTE_HTTP/TTS_REMOTE_HTTP 同一条隧道）。
# 留空=本机直连 ComfyUI(开发态)。worker 端点 /h3/generate，健康检查 /h3/health。
H3_REMOTE_HTTP=http://127.0.0.1:18080
# H3 生成前显存预检阈值(MiB)。显存低于该值时只释放 worker 内的小模型
# (TTS/人脸等)，不动 ComfyUI 大模型，避免下次加载过慢。默认 512(0.5G)。
# H3_MIN_FREE_MIB=512
# H3 段间交叉溶解时长(秒)，默认 0（硬切，保证口型精确）。
# 设为 >0 会柔和过渡但会缩短总时长、可能影响口型对齐。
# H3_XFADE_SECONDS=0
# 背景音乐文件路径（可选），设置后自动以低音量混入成片；音量默认 0.12。
# H3_BGM_PATH=D:\bgm\soft.mp3
# H3_BGM_VOLUME=0.12
